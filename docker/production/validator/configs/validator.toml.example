# Validator — one [[sources]] block per chain THIS operator watches.
#
# Everything here is per-operator. `block_confirmation` in particular is not a
# fleet-wide constant: a validator on a slower or less-trusted endpoint should
# sit further from the tip, and nothing requires operators to agree. A more
# conservative one simply signs later.

[[sources]]
chain_id = 1
# YOUR OWN endpoints — not the ones another validator uses. Ordered failover;
# the validator moves to the next on error and guards chainId on each.
rpcs = [
  "https://your-node.example.com",
  "https://your-backup-node.example.com",
]
gate = "0x0000000000000000000000000000000000000000"
start_block = 0
# SECURITY CRITICAL. Signing at the chain tip lets a source reorg erase the
# deposit AFTER the keeper has already released destination liquidity — a
# double-spend of bridge funds. Must exceed this chain's maximum reorg depth.
# Startup FAILS at 0 unless allow_zero_confirmation is also set, which is
# correct only on an instant-finality dev chain.
block_confirmation = 64
poll_interval_ms = 2000
max_block_range = 1000
# Must be on the `validator-state` volume, and unique per source chain.
state_file = "/data/chain-1-state.json"
# Optional; only while behind. See operations.md §3.2 before enabling — on a
# shared rate-limited endpoint this starves other consumers of the same key.
# catchup_poll_interval_ms = 50

# [[sources]]
# chain_id = 56
# rpcs = ["https://your-bsc-node.example.com"]
# gate = "0x…"
# start_block = 0
# block_confirmation = 30
# poll_interval_ms = 2000
# max_block_range = 1000
# state_file = "/data/chain-56-state.json"

# Key custody. Exactly one source may be set; a keystore is the production
# choice. Both paths below are docker secrets, mounted read-only at /run/secrets
# by the compose file. NEVER use `private_key = "0x…"` here.
[signer]
keystore = "/run/secrets/validator_keystore"
keystore_password_file = "/run/secrets/keystore_password"

# The shared store, over TLS. Plain http:// puts the bearer token on the wire in
# cleartext, and a captured sign token is a stolen credential.
[store]
url = "https://sig-store.example.com"

# Optional operator API. Published to host loopback only by the compose file.
[api]
bind = "0.0.0.0:9090"
# token comes from VALIDATOR_API_TOKEN in .env

# ── Peer gates: the bridge-decimals cross-check ───────────────────────────────
# REQUIRED. List every chain any [[sources]] entry above can send to. This node
# will NOT sign a transfer to a chain it cannot read here — that is deliberate.
#
# Why (audit 2026-09-16, H-2): every transfer travels in a per-asset "bridge
# decimals" scale. The source gate divides the locked amount by ITS registered
# scale and the destination multiplies by ITS OWN, and the submissionId does not
# commit to either. Two gates that disagree by one digit therefore pay a power of
# ten too much or too little on an ORDINARY user's transfer — no attacker needed,
# and both registrations are write-once, so it cannot be corrected in place.
#
# `Gate.claim` is permissionless and the collected signatures are public, so once
# a quorum exists anyone can complete the transfer. Withholding the signature is
# the only thing that still stops it, which is why this is checked here and why
# an unreadable destination is refused rather than assumed fine.
#
# Omit this and the validator falls back to [[refund.destinations]] below, which
# has the same shape. Configure one of the two.
#
# A gate deployed before `bridgeDecimalsFor(bytes32)` existed is still readable:
# the validator falls back to `tokenOf` + `bridgeDecimalsOf`. A read that fails in
# transit (rate limit, timeout) is RETRIED, not treated as a refusal — only a
# definitive answer (a mismatch, no corridor) withholds the signature.
[[destinations]]
chain_id = 56
rpcs = ["https://your-bsc-node.example.com"]
gate = "0x0000000000000000000000000000000000000000"

# EVM->Solana needs its own entry: an EVM gate reader can never vouch for a
# Solana payout, and this check fails closed, so WITHOUT this block every
# transfer from your sources to Solana is refused (found replaying live traffic).
# The validator reads the gate program's ["asset", debridgeId] account to learn
# the scale Solana pays out at. Omit only if no source here can send to Solana.
[[solana_destinations]]
chain_id = 7565164
program_id = "YourSolanaGateProgramId111111111111111111111"
rpc = "https://your-solana-rpc.example.com"

# ── Refund attestation ────────────────────────────────────────────────────────
# Omit this whole block and this validator never votes on whether a stranded
# transfer may be cancelled or refunded. That is the SAFE default, not a
# degraded one: a node that cannot independently read the destination chain must
# not have an opinion on whether a transfer was delivered.
#
# If you do enable it, list every destination you can verify — and only those.
# A transfer bound for a chain not listed here is never attested.
[refund]
# How long a transfer must sit unclaimed before this node will attest a cancel.
# THIS value binds, not the indexer's: the validator establishes the age itself
# by reading `sentBy(id)` at a block whose own timestamp is that far behind the
# chain head. Set it to match the indexer's `refund_timeout_secs` so the two
# agree on intent. Wall-clock skew on this host does not affect it.
timeout_secs = 3600
poll_interval_ms = 30000
# SECURITY CRITICAL. A refund is irreversible and is authorised solely on having
# read `cancelled == true` on the DESTINATION. Read that at the tip and a
# destination reorg re-enables the original claim signatures — the transfer is
# paid on the destination AND refunded on the source. Must exceed the
# DESTINATION chain's maximum reorg depth.
block_confirmation = 64

[[refund.destinations]]
chain_id = 56
rpcs = ["https://your-bsc-node.example.com"]
gate = "0x0000000000000000000000000000000000000000"

# --- allowlist enforcement (audit 2026-09-16, M-5) ----------------------------
#
# The sig-store is UNTRUSTED. Until this block exists, an empty or absent
# allowlist means "no restriction" — which is also what a compromised or
# truncated store serves, so the kill-switch could be switched off by the very
# component it guards against. Opting in turns that into a refusal: the node
# skips the tick (logging why) rather than acting on a list it cannot trust.
#
# `require = true` alone is enough. Pinning names entries that MUST be present,
# which also catches a partial truncation; pinning implies `require`.
#
# [allowlist]
# require = true
# pinned_tokens = ["0x…debridge_id…"]
# pinned_chains = [[11155111, 560048]]

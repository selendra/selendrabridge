# ─── MACHINE 1: the store ─────────────────────────────────────────────────────
# cp .env.example .env, fill EVERY value, then `chmod 600 .env`.

# --- image -------------------------------------------------------------------
# Registry ref if you build once and push (recommended: every machine then runs
# a byte-identical binary). Leave the default to build locally from this repo,
# which requires the source tree to be present on this machine.
BRIDGE_IMAGE=selendra/bridge:local
# `missing` pulls only if absent; use `always` when tracking a moving tag.
BRIDGE_PULL_POLICY=missing

# --- postgres ----------------------------------------------------------------
POSTGRES_USER=bridge
POSTGRES_DB=bridge
# openssl rand -hex 32
POSTGRES_PASSWORD=

# --- sig-store scoped tokens -------------------------------------------------
# One per role, each a FRESH random secret:  openssl rand -hex 32
# Distribute them as follows, and never more widely:
#   SIG_STORE_VALIDATOR_TOKEN -> every validator machine   (read + sign)
#   SIG_STORE_KEEPER_TOKEN    -> the keeper machine        (read + mark-claimed)
#   SIG_STORE_READER_TOKEN    -> the API machine           (read only)
#   SIG_STORE_ADMIN_TOKEN     -> nowhere; keep it offline  (allowlist writes)
#   SIG_STORE_INDEXER_TOKEN   -> the DELIVERING Solana relayer only: its marker
#                                observer reports observed claimed/cancelled/
#                                refunded, which is AUTHORITATIVE (moves the
#                                lifecycle, unlike the keeper's advisory report)
SIG_STORE_VALIDATOR_TOKEN=
SIG_STORE_KEEPER_TOKEN=
SIG_STORE_READER_TOKEN=
SIG_STORE_ADMIN_TOKEN=
SIG_STORE_INDEXER_TOKEN=

# --- TLS ---------------------------------------------------------------------
# Public DNS name of THIS machine. Every other stack points its store URL here.
SIG_STORE_DOMAIN=sig-store.example.com
ACME_EMAIL=ops@example.com
# Space-separated CIDRs allowed to reach the store at all: every validator host,
# the keeper host, and the API host. Narrow this. "0.0.0.0/0 ::/0" disables it.
OPERATOR_CIDRS=203.0.113.7/32 203.0.113.8/32 198.51.100.20/32

RUST_LOG=info

# ─── MACHINE 5: the public surface ────────────────────────────────────────────
# cp .env.example .env, fill it in, then `chmod 600 .env`.

BRIDGE_IMAGE=selendra/bridge:local
FRONTEND_IMAGE=selendra/bridge-frontend:local
BRIDGE_PULL_POLICY=missing

# --- the store ---------------------------------------------------------------
# The store machine's public name. https, always: this token crosses the network
# on every request.
SIG_STORE_URL=https://sig-store.example.com
# Read scope ONLY. Never put the validator, keeper or admin token on this box.
SIG_STORE_READER_TOKEN=

# Must match the gates' on-chain `threshold`, or the UI reports the wrong
# ready/meetsThreshold state. It is display logic only — nothing is enforced here.
BRIDGE_THRESHOLD=2

# --- repeatable flags --------------------------------------------------------
# `--gate` and `--swap` may each appear many times, which compose cannot build
# from a list, so these are word-split by a shell. Space-separated, one
# `--gate`/`--swap` per entry, NO quotes inside the value.
#
#   --gate CHAINID=RPC,GATE
#   --swap CHAINID=RPC,POOL[,FROM_BLOCK[,MAX_RANGE]]
#
# A Solana entry is recognised by its base58 (non-0x) address.
GRAPHQL_GATES=--gate 1=https://your-node.example.com,0xGate1 --gate 56=https://your-bsc-node.example.com,0xGate56
GRAPHQL_SWAPS=--swap 1=https://your-node.example.com,0xPool1,18000000,1000

# Caps a single eth_getLogs span for pool reads. Match your provider's limit.
GRAPHQL_MAX_BLOCK_RANGE=1000

# --- TLS ---------------------------------------------------------------------
APP_DOMAIN=bridge.example.com
ACME_EMAIL=ops@example.com

RUST_LOG=info

# --- client addresses (audit round 7, M7-5) ---------------------------------
# The private network caddy -> frontend (nginx) -> graphql-api share. Both
# rate limits (nginx and graphql-api) believe X-Forwarded-For only from this
# range, so it must be a range only those three containers live on. Change it
# only if it collides with a network on the host (then `down` + `up -d`).
BRIDGE_API_SUBNET=172.30.88.0/24

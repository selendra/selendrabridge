# Public TLS front for the SPA. No IP allowlist here — this one is meant to be
# reachable. Everything behind it is read-only (see the compose header).

{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The client's address, for the per-client rate limits behind us (audit
	# round 7, M7-5). Caddy is the edge, so it trusts no incoming forwarding
	# header (no `trusted_proxies`): both are OVERWRITTEN with the TCP peer,
	# never appended to, so a client cannot pick its own bucket. nginx believes
	# them only from this network's subnet (BRIDGE_REAL_IP_FROM).
	reverse_proxy frontend:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format console
	}
}

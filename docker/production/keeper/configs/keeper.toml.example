# Keeper — TWO DIFFERENT LISTS, and mixing them up is the classic mistake.
#
#   [[targets]] = where transfers are DELIVERED. Claims and cancels run here.
#   [[sources]] = where funds were LOCKED.      Refunds run here.
#
# A keeper with no [[sources]] never submits a refund, and nothing warns you at
# runtime — the transfers simply sit in the candidate list forever. For a full
# mesh, every chain usually appears in both lists.

[[targets]]
chain_id = 56
rpc = "https://your-bsc-node.example.com"
gate = "0x0000000000000000000000000000000000000000"
poll_interval_ms = 2000

[[sources]]
chain_id = 1
rpc = "https://your-node.example.com"
gate = "0x0000000000000000000000000000000000000000"
poll_interval_ms = 2000

# A chain listed in BOTH lists logs a warning at startup: the two loops submit
# from one account on one chain and can briefly contend on its nonce under load.
# It is self-healing (the provider fetches the pending nonce fresh for every tx),
# but for a busy bidirectional corridor run the two roles as separate keeper
# processes, or give them separate funded accounts.

# The funded gas-payer key. Same custody options as a validator's [signer];
# a keystore is the production choice. NEVER `private_key = "0x…"` here.
[keeper]
keystore = "/run/secrets/keeper_keystore"
keystore_password_file = "/run/secrets/keystore_password"

[store]
url = "https://sig-store.example.com"

# --- allowlist enforcement (audit 2026-09-16, M-5) ----------------------------
#
# The sig-store is UNTRUSTED. Until this block exists, an empty or absent
# allowlist means "no restriction" — which is also what a compromised or
# truncated store serves, so the kill-switch could be switched off by the very
# component it guards against. Opting in turns that into a refusal: the node
# skips the tick (logging why) rather than acting on a list it cannot trust.
#
# `require = true` alone is enough. Pinning names entries that MUST be present,
# which also catches a partial truncation; pinning implies `require`.
#
# [allowlist]
# require = true
# pinned_tokens = ["0x…debridge_id…"]
# pinned_chains = [[11155111, 560048]]

# Serve the built SPA and proxy the backend calls to graphql-api same-origin.
#
# A TEMPLATE, not a plain conf: the nginx entrypoint runs envsubst over
# /etc/nginx/templates/*.template at startup, which is how `connect-src` below
# can be set per deployment without rebuilding the image.

# --- per-client limit, in front of graphql-api (audit round 7, M7-5) ---------
#
# Defence in depth for the API's own per-client bucket. Keyed on
# $binary_remote_addr, which is the CLIENT only because of the real_ip block
# below; without that it would be the TCP peer — in production Caddy, i.e. one
# bucket for everyone again. Looser than the API's 25 rps / 100 burst so a
# legitimate page load never trips it first. This file is included inside
# `http {}`, which is where a zone has to be declared.
limit_req_zone $binary_remote_addr zone=bridge_api:10m rate=30r/s;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # --- who the client is (M7-5) ---------------------------------------------
    #
    # Believe X-Forwarded-For ONLY from the proxy in front of us (production:
    # Caddy, on the pinned `bridge-api` subnet). From any other peer the header
    # is client-supplied and ignored, and $remote_addr stays the TCP peer. The
    # image default (127.0.0.1/32) trusts nobody, which is right wherever nginx
    # itself is the edge. `real_ip_recursive` takes the rightmost hop that is not
    # itself trusted, so a value the client prepended is never the one used.
    set_real_ip_from ${BRIDGE_REAL_IP_FROM};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # --- security headers (audit 2026-09-16, M-16) ---------------------------
    #
    # This page hand-encodes `Gate.send` calldata and asks a wallet to sign it.
    # One injected script could re-target a transfer to its own receiver, and
    # nothing here set a single header. `always` so they are sent on error
    # responses too, not just 200s.
    #
    # `script-src 'self'` is the directive that matters, and the Vite build is
    # compatible with it as-is: `dist/index.html` references one module bundle
    # by src and carries no inline script. Keep it that way — an inline script
    # would need a hash or a nonce, never 'unsafe-inline'.
    #
    # `style-src 'self'` blocks remote and injected <style>, while
    # `style-src-attr 'unsafe-inline'` allows the two `style={{…}}` attributes
    # the UI uses for layout. Splitting them keeps stylesheet injection blocked;
    # a style ATTRIBUTE cannot execute script in any browser this app supports.
    #
    # `connect-src` is the one directive a static policy cannot pin: the RPC
    # endpoints come from the chain registry the API serves at runtime. The
    # default allows any HTTPS/WSS origin plus loopback (local anvil/validator
    # stacks), which stops plaintext exfiltration to an attacker's http:// host
    # but not an https:// one. A deployment that knows its endpoints should
    # narrow it — set BRIDGE_CSP_CONNECT_SRC to an explicit list, e.g.
    #   BRIDGE_CSP_CONNECT_SRC="'self' https://eth-sepolia.example https://api.devnet.solana.com"
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ${BRIDGE_CSP_CONNECT_SRC}; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; manifest-src 'self'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    # Matches the production Caddyfile, which sets this one at the edge — two
    # topologies disagreeing about the same header is a debugging trap.
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()" always;

    # SPA history fallback — unknown routes serve index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # GraphQL + health go to the API service on the compose network.
    #
    # Docker's embedded DNS, and the upstream held in a VARIABLE on purpose:
    # with a literal host nginx resolves it once at startup and keeps the
    # address forever, so recreating the API container (a new IP) leaves the UI
    # serving 502s until someone restarts nginx too. A variable forces
    # re-resolution per request, which is what makes the stack survive a
    # redeploy of just the API.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /graphql {
        limit_req zone=bridge_api burst=120 nodelay;
        limit_req_status 429;
        set $api http://graphql-api:8088;
        proxy_pass $api/graphql;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        # OVERWRITE, never append ($proxy_add_x_forwarded_for would carry
        # whatever the client sent): graphql-api trusts these from this hop
        # (`--trusted-proxy`) and keys its rate limit on them.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location /health {
        set $api_health http://graphql-api:8088;
        proxy_pass $api_health/health;
    }
}

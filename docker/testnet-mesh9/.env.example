# Template. Every secret must be a fresh random value:  openssl rand -hex 32
# One token per role, so a leak from one component cannot act as another.
# INDEXER is the Solana relayer's marker-observer credential (authoritative lifecycle reports).
POSTGRES_PASSWORD=
SIG_STORE_VALIDATOR_TOKEN=
SIG_STORE_KEEPER_TOKEN=
SIG_STORE_READER_TOKEN=
SIG_STORE_ADMIN_TOKEN=
SIG_STORE_INDEXER_TOKEN=
# EVM RPC endpoints for the relayers' [[refund.evm]] readers (rpc_env); may carry provider keys
RPC_11155111=
RPC_560048=
RPC_10143=
